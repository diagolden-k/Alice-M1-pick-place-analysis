  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Torso Link -->
  <link name="torso_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/alice_m1/UPPER_BODY.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0012034 -0.0000329 -0.2260786"/>
      <geometry>
        <box size="0.1766732 0.2271206 0.133126"/>
