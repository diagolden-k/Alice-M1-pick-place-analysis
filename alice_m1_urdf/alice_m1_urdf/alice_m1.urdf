<?xml version="1.0" ?>
<robot name="alice_m1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.265"/>
  <xacro:property name="wheel_length" value="0.031"/>
  <xacro:property name="wheel_separation" value="0.45"/>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
